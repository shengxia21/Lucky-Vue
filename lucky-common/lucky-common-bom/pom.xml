    </description>

    <properties>
        <revision>1.0.0</revision>
    </properties>

    <dependencyManagement>
        <dependencies>

            <!-- 核心模块 -->
            <dependency>
                <groupId>com.lucky</groupId>
                <artifactId>lucky-common-core</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- excel -->
            <dependency>
                <groupId>com.lucky</groupId>
                <artifactId>lucky-common-excel</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- json -->
            <dependency>
                <groupId>com.lucky</groupId>
                <artifactId>lucky-common-log</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- 数据库服务 -->
