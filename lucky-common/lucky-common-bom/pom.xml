                <groupId>com.lucky</groupId>
                <artifactId>lucky-common-mybatis</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- 缓存服务 -->
            <dependency>
                <groupId>com.lucky</groupId>
                <artifactId>lucky-common-redis</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- 安全模块 -->
            <dependency>
                <groupId>com.lucky</groupId>
                <artifactId>lucky-common-security</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- web服务 -->
            <dependency>
                <groupId>com.lucky</groupId>
                <artifactId>lucky-common-web</artifactId>
                <version>${revision}</version>
            </dependency>

        </dependencies>
    </dependencyManagement>

</project>